# --- LLM : Mistral ---
# https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
# Modèle VLM utilisé par le tuteur (peut voir les images retournées par le RAG).
# Alternatives : pixtral-large-latest (payant, meilleure qualité)
MISTRAL_MODEL=pixtral-12b-2409

# --- Embeddings ---
# Modèle texte (sentence-transformers). Léger, universel, 384 dim.
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Modèle CLIP (open_clip). ViT-B-32 = bon compromis vitesse/qualité.
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# --- RAG ---
# Nombre de résultats retournés par collection avant fusion.
RAG_TOP_K_TEXT=5
RAG_TOP_K_IMAGE=3
# Paramètre du Reciprocal Rank Fusion.
RAG_RRF_K=60
# Score cosine texte minimal pour appeler le LLM (sinon réponse "hors corpus" déterministe).
RAG_MIN_SCORE=0.25

# --- Ingestion ---
CHUNK_SIZE=800 
CHUNK_OVERLAP=150
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100

# --- Tuteur : adaptation de niveau (échelle de score 1-5) ---
ADAPT_SCORE_UP=4
ADAPT_SCORE_DOWN=2
CHROMA_PERSIST_DIR=data/chroma

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- UI ---
UI_PORT=8501
# URL utilisée par Streamlit pour joindre l'API (localhost en dev, service Docker en prod).
API_BASE_URL=http://localhost:8000
